{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/about/?", "dest": "/about/index.html" },
    { "src": "/projects/?", "dest": "/projects/index.html" },
    { "src": "/projects/release-log/?", "dest": "/projects/release-log/index.html" },
    { "src": "/projects/upkeep/?", "dest": "/projects/upkeep/index.html" },
    { "src": "/projects/lucjoosten-nl/?", "dest": "/projects/lucjoosten-nl/index.html" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
